# Meta (Facebook/Instagram) Pixel + Conversions API (optional).
# Leave empty to fully disable Meta tracking (no Pixel script, no CAPI calls).
# Browser Pixel id (public). Found in Events Manager > Data Sources.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (secret). Events Manager > Settings > Generate Access Token.
META_CAPI_ACCESS_TOKEN=
# CAPI dataset/pixel id; defaults to NEXT_PUBLIC_META_PIXEL_ID when empty.
META_CAPI_PIXEL_ID=
# Optional: a Test Events code (Events Manager > Test Events) to validate server
# events without affecting live metrics. Leave empty in production.
META_CAPI_TEST_EVENT_CODE=
