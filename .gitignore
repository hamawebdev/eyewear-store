# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local CMS database
payload.db
payload.db-*

# vercel
.vercel

# editor
.idea

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling
/.agents/
/.claude/
skills-lock.json

# Payload upload dir (Docker volume in production)
/media/

# Point-in-time media relationship snapshot for `npm run media:verify -- --baseline`.
# Regenerate before a backfill; not worth versioning.
media-snapshot.json
